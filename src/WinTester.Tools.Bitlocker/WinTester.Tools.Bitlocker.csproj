<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.Bitlocker</RootNamespace>
    <!-- Plain net8.0, not net8.0-windows — same reasoning as WinTester.Tools.Activation: the
         powershell.exe process launches here only function on Windows at runtime (guarded by
         OperatingSystem.IsWindows() where it matters), but the project itself should still restore/build
         on a non-Windows dev machine or CI runner. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
  </ItemGroup>

</Project>
