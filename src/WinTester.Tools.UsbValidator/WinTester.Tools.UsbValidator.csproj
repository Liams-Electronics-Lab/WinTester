<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.UsbValidator</RootNamespace>
    <!-- Plain net8.0, not net8.0-windows — same reasoning as every other WinTester.Tools.* project: the
         SetupAPI/usbioctl.h P/Invoke surface only functions on Windows at runtime, but the project itself
         should still restore/build on a non-Windows dev machine or CI runner. No WinTester.Core reference:
         unlike most Tools.* projects this one has no dependency on Core's shared models (ITestModule,
         SensorSnapshot, etc.) — it's a self-contained hub/port enumerator plus a report builder, same as
         the standalone app it was ported from. -->
  </PropertyGroup>

</Project>
