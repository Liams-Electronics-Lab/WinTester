<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tests.Cpu</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI access for CpuVendorDetector (Win32_Processor.Manufacturer). Informational only — degrades to
         CpuVendor.Unknown on non-Windows or on any WMI failure (see that class). Kept as net8.0 rather than
         net8.0-windows so this project (and its non-hardware-dependent pieces) can still restore/build on a
         non-Windows dev machine or CI runner; the WMI call itself is guarded by OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
