<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.WebcamMic</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- net8.0-windows + UseWPF (unlike the plain-net8.0 Tests.* projects): CameraCaptureSession converts
         each captured frame straight to a frozen WPF BitmapSource here, so WebcamMicTesterWindow's
         code-behind only ever sets Image.Source — no System.Drawing.Bitmap or DirectShow type crosses into
         WinTester.App. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Webcam enumeration/capture via DirectShow. Unmaintained since ~2013 but still the standard
         lightweight way to talk to DirectShow video capture devices from managed code with no native
         binaries to vendor — OpenCvSharp/Emgu were considered and rejected for the ~40-90MB of native
         OpenCV binaries either would add to every build just for a preview window. -->
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <!-- Both AForge packages predate SDK-style/PackageReference-based dependency resolution and target
         classic .NET Framework, where System.Drawing.Bitmap (NewFrameEventArgs.Frame's type) ships in the
         framework itself. An explicit reference here makes sure it resolves the same way under net8.0. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- Mic enumeration/capture (WaveInEvent) and playback (WaveOutEvent) — the de facto standard managed
         wrapper over the Windows waveIn/waveOut APIs, actively maintained, no native dependencies beyond
         what Windows itself ships. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
