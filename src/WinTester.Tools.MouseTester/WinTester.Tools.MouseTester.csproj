<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.MouseTester</RootNamespace>
    <!-- Plain net8.0, not net8.0-windows: grid layout and lit/unlit progress tracking are plain managed
         code with no WPF dependency. All WPF input plumbing (mouse capture, touch device tracking, the
         fullscreen window itself) lives in WinTester.App, same runner-vs-window split as
         WinTester.Tools.KeyboardTester. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
  </ItemGroup>

</Project>
