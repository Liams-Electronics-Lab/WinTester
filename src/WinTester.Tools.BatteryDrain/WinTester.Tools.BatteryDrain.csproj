<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.BatteryDrain</RootNamespace>
    <!-- Plain net8.0, not net8.0-windows — same reasoning as WinTester.Tests.Power: the WMI battery-status
         queries and child-process stress engines here only function on Windows at runtime (guarded by
         OperatingSystem.IsWindows() where it matters), but the project itself should still restore/build
         on a non-Windows dev machine or CI runner. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
    <!-- Battery Drain (Tab 2 tool) reuses the exact same load-generation engines already vendored and
         wrapped for the Power tile's calibration passes, rather than carrying a second copy of that logic
         — IpdtModuleRunner/CpuVendorDetector from Tests.Cpu, FurmarkRunner/WindowScreenRect from Tests.Gpu,
         and BatteryHealthReader (design/full-charge capacity + health %) from Tests.Power. Same "depends on
         the engine runners, not the other way around" direction as WinTester.Tests.Power's own reference to
         Tests.Cpu/Tests.Gpu. -->
    <ProjectReference Include="..\WinTester.Tests.Cpu\WinTester.Tests.Cpu.csproj" />
    <ProjectReference Include="..\WinTester.Tests.Gpu\WinTester.Tests.Gpu.csproj" />
    <ProjectReference Include="..\WinTester.Tests.Power\WinTester.Tests.Power.csproj" />
    <!-- Reuses HtmlReportGenerator's vendored Chart.js embedded resource (GetVendoredChartJsSource) rather
         than shipping a second copy. -->
    <ProjectReference Include="..\WinTester.Reporting\WinTester.Reporting.csproj" />
    <!-- The report embeds a Windows Activation subsection (shared System Information card, see
         BatteryReportSharedStyle.AppendSystemInformation) — needs ActivationInfoService to capture a fresh
         ActivationSnapshot once per run, same as MainViewModel already does for the regular report. -->
    <ProjectReference Include="..\WinTester.Tools.Activation\WinTester.Tools.Activation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI access for BatteryRuntimeStatusReader (root\WMI BatteryStatus — live RemainingCapacity/
         Voltage/ChargeRate/DischargeRate) — same package/version already proven out by
         WinTester.Tests.Power's BatteryHealthReader. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
