<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.Devices</RootNamespace>
    <!-- Plain net8.0, not net8.0-windows — same reasoning as WinTester.Tools.Activation and
         WinTester.Tools.Bitlocker: the WMI queries and the rundll32/mmc launches here only function on
         Windows at runtime (guarded by OperatingSystem.IsWindows() where it matters), but the project
         itself should still restore/build on a non-Windows dev machine or CI runner. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Win32_PnPEntity enumeration. 8.0.0 matches every other WMI consumer in the solution except
         WinTester.Sensors, which is pinned to 10.0.2 by LibreHardwareMonitorLib's own minimum. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
