<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.Activation</RootNamespace>
    <!-- Plain net8.0, not net8.0-windows — same reasoning as WinTester.Tests.Storage/Cpu: the WMI queries
         and cscript.exe/slmgr.vbs process launches here only function on Windows at runtime (guarded by
         OperatingSystem.IsWindows() where it matters), but the project itself should still restore/build
         on a non-Windows dev machine or CI runner. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI access (Win32_OperatingSystem, SoftwareLicensingProduct, SoftwareLicensingService) — same
         package/version already proven out by WinTester.Tests.Storage's DiskInfoProvider and
         WinTester.Tests.Cpu's CpuVendorDetector. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
