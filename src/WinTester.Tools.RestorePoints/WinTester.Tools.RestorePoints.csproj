<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tools.RestorePoints</RootNamespace>
    <!-- Plain net8.0 like WinTester.Tools.Devices. Windows-only classes carry SupportedOSPlatform("windows"). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI access to SystemRestore and Win32_ShadowStorage. Same version as the other WMI projects. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
