<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTester.Tests.Power</RootNamespace>
    <!-- Plain net8.0, not net8.0-windows — same reasoning as every other Tests.* project: the WMI calls
         in ComponentInventory.cs/BatteryHealthReader.cs/MachineClassifier.cs only function on Windows at
         runtime (guarded by OperatingSystem.IsWindows() where it matters), but the project itself should
         still restore/build on a non-Windows dev machine or CI runner. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTester.Core\WinTester.Core.csproj" />
    <!-- The "quick calibration pass" reuses the exact same load-generation engines already vendored and
         wrapped for the CPU/GPU tests, rather than this module carrying a second copy of that logic —
         IpdtModuleRunner/CpuVendorDetector from Tests.Cpu, FurmarkRunner/Win32Interop's WindowScreenRect
         from Tests.Gpu. Safe direction for a project reference: Power depends on Cpu/Gpu's *engine
         runners*, not the other way around — no cycle. -->
    <ProjectReference Include="..\WinTester.Tests.Cpu\WinTester.Tests.Cpu.csproj" />
    <ProjectReference Include="..\WinTester.Tests.Gpu\WinTester.Tests.Gpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI access for BatteryHealthReader (Win32_Battery/BatteryStaticData/BatteryFullChargedCapacity),
         MachineClassifier (Win32_Battery/ACPI PNP0C0A/ACPI0003 presence), and ComponentInventory
         (Win32_DiskDrive, Win32_PnPEntity, Win32_CDROMDrive, Win32_PhysicalMemory, etc., feeding the
         component table) — same package/version already proven out by Tests.Cpu/Tests.Storage. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
