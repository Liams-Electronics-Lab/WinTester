<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone scratch harness for the non-WPF Recovery Provisioning logic. Not part of the solution.
       Run it from the src folder with the dotnet run command, pointing its project option at this folder.
       It links the real source files, so it checks the code that ships. Exit code 0 means all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RecoveryProvisioning.Check</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\RecoveryModels.cs" Link="linked\RecoveryModels.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\UsmtLocator.cs" Link="linked\UsmtLocator.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\RulesXmlBuilder.cs" Link="linked\RulesXmlBuilder.cs" />
