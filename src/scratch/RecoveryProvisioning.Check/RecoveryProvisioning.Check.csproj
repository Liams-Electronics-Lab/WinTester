    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\DeploymentDetector.cs" Link="linked\DeploymentDetector.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\ScanStateCommand.cs" Link="linked\ScanStateCommand.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\ScanStateOutput.cs" Link="linked\ScanStateOutput.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\ScanStateRunner.cs" Link="linked\ScanStateRunner.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\RecoveryStaging.cs" Link="linked\RecoveryStaging.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\PackageActions.cs" Link="linked\PackageActions.cs" />
    <Compile Include="..\..\WinTester.App\Deployment\RecoveryProvisioning\AppDiscovery.cs" Link="linked\AppDiscovery.cs" />
