<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The library marks Windows-only classes with SupportedOSPlatform. The checks only call the pure members. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WinTester.Tools.DiskInfo\WinTester.Tools.DiskInfo.csproj" />
  </ItemGroup>

</Project>
