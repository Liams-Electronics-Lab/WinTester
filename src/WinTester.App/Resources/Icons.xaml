<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Simple, dependency-free vector icons (WPF PathGeometry) keyed by test module Id, used by
        TestTileControl. These are stand-ins for real SVG art: swap in an SVG library (e.g. SharpVectors)
        later if per-brand custom icon sets are needed; nothing else in the tile control needs to change,
        it just resolves "{module Id}Icon" from this dictionary.

        cpuIcon/gpuIcon/storageIcon/memoryIcon/powerIcon (and gpuFanIcon/gpuFanIcon2/storageHubIcon below,
        which only existed to accent those five) are no longer used by TestTileControl, 
        ModuleIdToIconConverter now returns real PNG art (vendor/icons/*.png) for those five ids instead.
        Left in place, not deleted: batteryIcon below is still live (Tab 2's still-to-come Battery
        Discharge Test has no supplied PNG yet), and gearIcon is still used by the Advanced Mode button, 
        deleting the five superseded entries above them would mean carefully untangling which geometries
        the (still-live) batteryIcon/gearIcon comments below refer to, for no real benefit over just
        leaving harmless unused resources in place.
    -->

    <!-- CPU: chip body + pins -->
    <Geometry x:Key="cpuIcon">
        M18,10 L18,6 L14,6 L14,2 L10,2 L10,6 L6,6 L6,2 L2,2 L2,6 L-2,6 L-2,10 L-6,10 L-6,14 L-2,14 L-2,18 L2,18
        L2,22 L6,22 L6,18 L10,18 L10,22 L14,22 L14,18 L18,18 L18,14 L22,14 L22,10 Z
        M4,8 L16,8 L16,16 L4,16 Z
    </Geometry>

    <!-- GPU: card body + fan -->
    <Geometry x:Key="gpuIcon">
        M1,6 L23,6 L23,18 L1,18 Z
        M4,18 L4,21 L7,21 L7,18
        M17,18 L17,21 L20,21 L20,18
    </Geometry>
    <EllipseGeometry x:Key="gpuFanIcon" Center="8,12" RadiusX="3.2" RadiusY="3.2" />
    <EllipseGeometry x:Key="gpuFanIcon2" Center="16,12" RadiusX="3.2" RadiusY="3.2" />

    <!-- Storage: disk platter -->
    <Geometry x:Key="storageIcon">
        M12,2 C17.5,2 22,4.7 22,8 L22,16 C22,19.3 17.5,22 12,22 C6.5,22 2,19.3 2,16 L2,8 C2,4.7 6.5,2 12,2 Z
        M22,8 C22,11.3 17.5,14 12,14 C6.5,14 2,11.3 2,8
    </Geometry>
    <EllipseGeometry x:Key="storageHubIcon" Center="12,8" RadiusX="2" RadiusY="2" />

    <!-- Memory: RAM stick with notches -->
    <Geometry x:Key="memoryIcon">
        M3,4 L21,4 L21,18 L18,18 L18,21 L15,21 L15,18 L13,18 L13,21 L10,21 L10,18 L8,18 L8,21 L5,21 L5,18 L3,18 Z
    </Geometry>

    <!-- Battery: body + terminal -->
    <Geometry x:Key="batteryIcon">
        M2,7 L18,7 L18,17 L2,17 Z
        M19,10 L21,10 L21,14 L19,14 Z
        M4,9 L8,9 L8,15 L4,15 Z
    </Geometry>

    <!-- Power: lightning bolt. Covers Battery Health (laptop-only) plus PSU/Adapter Power Budget (every
         machine), so a generic power glyph replaces a battery-shaped icon that wouldn't make sense on a
         tile that also runs on desktops with no battery at all. -->
    <Geometry x:Key="powerIcon">
        M13,2 L4,14 L11,14 L10,22 L20,10 L13,10 Z
    </Geometry>

    <!-- Gear (Advanced Mode settings) -->
    <Geometry x:Key="gearIcon">
        M12,8.5 C10.07,8.5 8.5,10.07 8.5,12 C8.5,13.93 10.07,15.5 12,15.5 C13.93,15.5 15.5,13.93 15.5,12
        C15.5,10.07 13.93,8.5 12,8.5 Z
        M12,2 L13.2,2 L13.6,4.3 C14.6,4.55 15.5,4.98 16.3,5.55 L18.4,4.5 L19.9,6 L18.85,8.1
        C19.4,8.9 19.85,9.8 20.1,10.75 L22.4,11.15 L22.4,12.85 L20.1,13.25 C19.85,14.2 19.4,15.1 18.85,15.9
        L19.9,18 L18.4,19.5 L16.3,18.45 C15.5,19 14.6,19.45 13.6,19.7 L13.2,22 L10.8,22 L10.4,19.7
        C9.4,19.45 8.5,19 7.7,18.45 L5.6,19.5 L4.1,18 L5.15,15.9 C4.6,15.1 4.15,14.2 3.9,13.25
        L1.6,12.85 L1.6,11.15 L3.9,10.75 C4.15,9.8 4.6,8.9 5.15,8.1 L4.1,6 L5.6,4.5 L7.7,5.55
        C8.5,4.98 9.4,4.55 10.4,4.3 Z
    </Geometry>

    <!-- Key (Windows Activation tool, Tab 2) [round bow + shaft + two teeth. Vector, not a supplied PNG,
         since Tab 2 currently has exactly one tile and doesn't yet warrant the vendor/icons/*.png +
         converter machinery Tab 1's five tiles use] revisit if/when a second Tab 2 tool needs its own
         distinct icon. -->
    <Geometry x:Key="keyIcon">
        M9,2 C12.31,2 15,4.69 15,8 C15,9.18 14.66,10.28 14.07,11.21 L22,19.14 L22,22 L19,22 L19,20 L17,20
        L17,18 L15,18 L13.5,16.5 L11.79,17.93 C10.86,17.34 9.76,17 8.58,17 C5.27,17 2.58,14.31 2.58,11
        C2.58,7.69 5.27,5 8.58,5
        M9,6 C7.34,6 6,7.34 6,9 C6,10.66 7.34,12 9,12 C10.66,12 12,10.66 12,9 C12,7.34 10.66,6 9,6 Z
    </Geometry>

    <!-- Lock (BitLocker tool, Tab 2), shackle + body. A distinct icon rather than reusing the key glyph
         for a tool that isn't about product keys at all. -->
    <Geometry x:Key="lockIcon">
        M7,10 L7,7 C7,4.24 9.24,2 12,2 C14.76,2 17,4.24 17,7 L17,10 L18,10 C19.1,10 20,10.9 20,12 L20,20
        C20,21.1 19.1,22 18,22 L6,22 C4.9,22 4,21.1 4,20 L4,12 C4,10.9 4.9,10 6,10 Z
        M9,10 L15,10 L15,7 C15,5.34 13.66,4 12,4 C10.34,4 9,5.34 9,7 Z
        M12,14 C13.1,14 14,14.9 14,16 C14,16.74 13.6,17.39 13,17.73 L13,19.5 C13,20.05 12.55,20.5 12,20.5
        C11.45,20.5 11,20.05 11,19.5 L11,17.73 C10.4,17.39 10,16.74 10,16 C10,14.9 10.9,14 12,14 Z
    </Geometry>

</ResourceDictionary>
