<Window x:Class="WinTester.App.Controls.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinTester.App.ViewModels"
        Title="Devices"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="880" Height="660"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Dark-theme TreeViewItem: the stock template's hover/selection brushes are the system's light
             defaults and read as a bright band across a dark window. Only the container chrome is
             restyled here; the row content itself comes from the HierarchicalDataTemplate below. -->
        <Style x:Key="DarkTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E1E3E8" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E3A57" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#26262B" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E1E3E8" />
            </Style.Resources>
        </Style>

        <!-- One template for all three levels. A group row shows its heading and count; a device row adds
             the error line and the explanation underneath. Both branches live in the same template with
             Visibility driven off IsDevice, rather than a template selector, because the rows share their
             accent bar and layout and differ only by which of two blocks is shown. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:DeviceTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <Grid Margin="0,2,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="1.5"
                        Margin="0,1,8,1" />

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" Foreground="#E1E3E8"
                                   FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                        <TextBlock Text="{Binding CountText}" Foreground="#7A7A82"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorText}"
                               Foreground="{Binding AccentBrush}"
                               FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"
                               Visibility="{Binding IsDevice, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DetailText}"
                               Foreground="#8A8A93" FontSize="11"
                               TextWrapping="Wrap" MaxWidth="640" Margin="0,1,0,0"
                               Visibility="{Binding IsDevice, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Devices" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Devices"
                               Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryText"
                               Text="Scanning devices..."
                               Foreground="#7A7A82" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Double-click a device to open its Windows properties dialog."
                               Foreground="#5E5E66" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#161618" BorderBrush="#3D3D42" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <TreeView x:Name="DeviceTree"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="#E1E3E8"
                                  Padding="10"
                                  ItemContainerStyle="{StaticResource DarkTreeViewItem}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="DeviceTree_MouseDoubleClick" />

                        <!-- Covers the tree during a scan and for the clean/failed outcomes, so the window
                             never shows an empty box with no explanation of why it's empty. -->
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Scanning devices..."
                                   Foreground="#7A7A82" FontSize="13"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="460"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock x:Name="ActionErrorText"
                               Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               MaxWidth="420" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PropertiesButton" Content="Properties" Width="100" Height="30"
                                Margin="0,0,10,0" Click="PropertiesButton_Click" IsEnabled="False"
                                Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                        <Button x:Name="RefreshButton" Content="Refresh" Width="90" Height="30"
                                Margin="0,0,10,0" Click="RefreshButton_Click"
                                Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                        <Button x:Name="OpenDeviceManagerButton" Content="Open Device Manager"
                                Width="170" Height="30" Margin="0,0,10,0"
                                Click="OpenDeviceManagerButton_Click"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                BorderThickness="0" />
                        <Button x:Name="CloseButton" Content="Close" Width="80" Height="30"
                                Click="CloseButton_Click"
                                Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
