<Window x:Class="WinTester.App.Controls.AudioTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="900" Height="560"
        Background="Black"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Collapsed while fullscreen; windowed mode keeps the same drag-to-move/close chrome every other
             Tab 2 tile uses. -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#1B1B1E"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Audio" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="&#x2715;" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Row="1" Background="Black" ClipToBounds="True">

            <!-- Visualizer surface. Double-click toggles fullscreen (only the surface itself, not the pill
                 sitting on top of it, so double-clicking a control never accidentally fullscreens/exits). -->
            <Canvas x:Name="VisualizerCanvas" Background="#0B0B0D"
                    MouseMove="ContentGrid_MouseMove"
                    MouseLeftButtonDown="VisualizerCanvas_MouseLeftButtonDown" />

            <TextBlock x:Name="MissingFileText"
                       Text="Audio file not found: vendor\Sounds\Title.mp3"
                       Foreground="#E0503A" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Speaker-layout overlay: the base "{key}.png" diagram when idle/not sweeping, swapped for
                 "{key}_{Label}.png" while the sweep highlights a channel. IsHitTestVisible="False" so it
                 never blocks the canvas's double-click-to-fullscreen or the pill's mouse-move fade-in
                 underneath it. White rounded card + shadow to match ControlsPill's look rather than a bare
                 rectangular image floating on the black canvas — not an explicit ask, flagged as a styling
                 choice. -->
            <Border x:Name="SpeakerOverlayBorder"
                    Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,20,0,0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Image x:Name="SpeakerOverlayImage" Stretch="None" />
                    <!-- Only shown over UNIVERSAL.png (the config isn't 2.0/4.0/5.1/7.1), which has no
                         per-channel artwork of its own. -->
                    <TextBlock x:Name="SpeakerOverlayFallbackText"
                               Foreground="#1B1B1E" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,14"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- White pill control bar. Fades in on mouse move / fullscreen start, fades out after 3s of no
                 mouse movement (handled in code-behind via a DispatcherTimer). -->
            <Border x:Name="ControlsPill"
                    Background="White"
                    CornerRadius="26"
                    Padding="14,8"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,26"
                    MouseMove="ContentGrid_MouseMove">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="2" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button x:Name="PlayPauseButton" Content="&#x25B6;" Width="34" Height="34"
                            FontSize="14" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="#1B1B1E"
                            Click="PlayPauseButton_Click" />
                    <Button x:Name="StopButton" Content="&#x25A0;" Width="34" Height="34"
                            FontSize="12" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="#1B1B1E"
                            Click="StopButton_Click" Margin="2,0,10,0" />

                    <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#4A4A4E" FontSize="11"
                               VerticalAlignment="Center" Width="30" />
                    <Slider x:Name="SeekSlider" Width="240" Minimum="0" Maximum="1" Value="0"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp" />
                    <TextBlock x:Name="DurationText" Text="0:00" Foreground="#4A4A4E" FontSize="11"
                               VerticalAlignment="Center" Width="30" Margin="0,0,10,0" />

                    <TextBlock Text="Vol" Foreground="#4A4A4E" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="1" Value="0.7"
                            VerticalAlignment="Center" Margin="0,0,12,0" />

                    <!-- Sweeps the audio through each detected speaker in turn; greyed via IsEnabled
                         when the default device is mono. Green fill while active. -->
                    <Button x:Name="SweepToggleButton" Content="&#x21BB;" Width="34" Height="34"
                            FontSize="15" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="#1B1B1E"
                            Click="SweepToggleButton_Click" Margin="0,0,2,0" />
                    <TextBlock x:Name="SweepStatusText" Text="" Foreground="#3DC96E" FontSize="10"
                               FontWeight="Bold" VerticalAlignment="Center" Width="55"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                    <Button x:Name="FullscreenButton" Content="&#x26F6;" Width="34" Height="34"
                            FontSize="14" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="#1B1B1E"
                            Click="FullscreenButton_Click" />

                    <Border Width="1" Background="#DDDDDD" Margin="10,4" />

                    <!-- Small close button, always on the pill regardless of window/fullscreen state. -->
                    <Button x:Name="ClosePillButton" Content="&#x2715;" Width="26" Height="26"
                            FontSize="11" Padding="0"
                            Background="#F0F0F0" BorderThickness="0" Foreground="#1B1B1E"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
