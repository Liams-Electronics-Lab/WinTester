<Window x:Class="WinTester.App.Controls.BusyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="Please wait" Foreground="#B7B7BE" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24">
            <StackPanel Width="360">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="14"
                           LineHeight="20" />

                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                             Foreground="{DynamicResource AccentBrush}" Background="#2A2A2E" BorderThickness="0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="30"
                            Click="CancelButton_Click"
                            Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
