<Window x:Class="WinTester.App.Controls.BatteryChargeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Charge Test"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Battery Charge Test" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

    <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24">
        <StackPanel Width="660">

            <TextBlock Text="Battery Charge Test" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Logs battery charge behavior at idle."
                       Foreground="#7A7A82" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

            <!-- ===================== Options panel (pre-run) ===================== -->
            <StackPanel x:Name="OptionsPanel">

                <TextBlock Text="Sweep mode" Foreground="#B7B7BE" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="WideSweepRadio" Content="Wide Sweep (&lt;15% → 100%)" GroupName="SweepMode" IsChecked="True"
                                 Foreground="#E1E3E8" Margin="0,0,16,0" Checked="SweepMode_Checked" />
                    <RadioButton x:Name="QuickTestRadio" Content="Quick Test (&lt;95% → 100%)" GroupName="SweepMode"
                                 Foreground="#E1E3E8" Margin="0,0,16,0" Checked="SweepMode_Checked" />
                    <RadioButton x:Name="PeakSweepRadio" Content="Peak Sweep (&lt;50% → 100%)" GroupName="SweepMode"
                                 Foreground="#E1E3E8" Checked="SweepMode_Checked" />
                </StackPanel>

                <TextBlock x:Name="SweepModeDescriptionText" Foreground="#7A7A82" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Starts below 15%. Stops at 100%, on zero current for 20 minutes, or on manual stop." />

                <StackPanel x:Name="PeakStallOptionsPanel" Visibility="Collapsed">
                    <CheckBox x:Name="EnablePeakStallDetectionCheckBox" Content="Stop on peak-current stall"
                              Foreground="#B7B7BE" FontSize="12" Margin="0,0,0,4" IsChecked="True" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="After" Foreground="#7A7A82" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="PeakStallMinPercentTextBox" Width="45" Text="90" Foreground="#E1E3E8" Background="#1C1C1F"
                                 BorderBrush="#3A3A40" Padding="4,2" />
                        <TextBlock Text="% battery, unbeaten for" Foreground="#7A7A82" FontSize="11" VerticalAlignment="Center" Margin="6,0,6,0" />
                        <TextBox x:Name="PeakStallMinutesTextBox" Width="45" Text="45" Foreground="#E1E3E8" Background="#1C1C1F"
                                 BorderBrush="#3A3A40" Padding="4,2" />
                        <TextBlock Text="minutes." Foreground="#7A7A82" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Current normally tapers below this threshold — not treated as a stall."
                               Foreground="#7A7A82" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14" />
                </StackPanel>

                <CheckBox x:Name="UseGpuLoadInPrepCheckBox" Content="Use GPU load during discharge-prep"
                          Foreground="#B7B7BE" FontSize="12" Margin="0,0,0,4" IsChecked="False" />
                <TextBlock Text="Applies only if discharge-prep runs."
                           Foreground="#7A7A82" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="Poll interval (seconds)" Foreground="#B7B7BE" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBox x:Name="PollIntervalTextBox" Width="60" Text="5" Foreground="#E1E3E8" Background="#1C1C1F"
                             BorderBrush="#3A3A40" Padding="4,2" />
                </StackPanel>
                <TextBlock Text="How often the test logs sensor data. Doesn't apply to discharge-prep or charger-wait."
                           Foreground="#7A7A82" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock x:Name="OptionsErrorText" Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartButton" Content="Start Test" Width="120" Height="30" Margin="0,0,10,0"
                            Click="StartButton_Click" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                    <Button x:Name="CloseOptionsButton" Content="Close" Width="80" Height="30"
                            Click="CloseButton_Click" Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <!-- ===================== Waiting panel (discharge-prep AND connect-charger phases) ===================== -->
            <StackPanel x:Name="WaitingPanel" Visibility="Collapsed">
                <TextBlock x:Name="WaitingTitleText" Text="Connect the charger" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,20,0,10" />
                <TextBlock x:Name="WaitingStatusText" Text="Waiting for AC power."
                           Foreground="#B7B7BE" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelWaitButton" Content="Cancel" Width="100" Height="30"
                            Click="StopButton_Click" Background="#D93B3B" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <!-- ===================== Running panel ===================== -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed">

                <TextBlock x:Name="TimerText" Text="00:00:00:00"
                           FontSize="34" FontWeight="Bold" Foreground="#3CB043"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />

                <Border Background="#161618" BorderBrush="#3D3D42" BorderThickness="1" CornerRadius="4"
                        Height="220" Margin="0,0,0,14">
                    <Canvas x:Name="GraphCanvas" ClipToBounds="True" SizeChanged="GraphCanvas_SizeChanged" />
                </Border>

                <!-- Row 1 -->
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Start Time" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="StartTimeText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Start %" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="StartPercentText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Start V" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="StartVoltageText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>

                <!-- Row 2 -->
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Current %" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="CurrentPercentText" Text="--" FontFamily="Consolas" FontSize="14" Foreground="#3CB043" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Current V" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="CurrentVoltageText" Text="--" FontFamily="Consolas" FontSize="14" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>

                <!-- Row 3 -->
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Charge Current (mA)" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="ChargeCurrentText" Text="--" FontFamily="Consolas" Foreground="#E0A030" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Charge Rate (W)" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="ChargeRateText" Text="--" FontFamily="Consolas" Foreground="#E0A030" />
                    </StackPanel>
                </UniformGrid>

                <!-- Row 4 -->
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Cap. Remaining (mWh)" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="RemainingCapacityText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Battery Temp (°C)" FontSize="10" Foreground="#8A8A93" />
                        <TextBlock x:Name="TemperatureText" Text="--" FontFamily="Consolas" Foreground="#FF4FC3" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock x:Name="RunningErrorText" Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StopButton" Content="Stop Test" Width="110" Height="30" Margin="0,0,10,0"
                            Click="StopButton_Click" Background="#D93B3B" Foreground="White" BorderThickness="0" />
                    <Button x:Name="CloseRunningButton" Content="Close" Width="80" Height="30"
                            Click="CloseButton_Click" IsEnabled="False"
                            Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Keyboard: Esc = Close (disabled while a test is running)" Visibility="Collapsed"
                       Foreground="#7A7A82" FontSize="10" HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
