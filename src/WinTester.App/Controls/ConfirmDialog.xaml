<Window x:Class="WinTester.App.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Confirm" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="NoButton_Click" />
            </Grid>
        </Border>

    <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24">
        <StackPanel Width="360">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="White"
                       FontSize="14"
                       LineHeight="20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="NoButton" Content="No (N)" Width="90" Height="30"
                        Margin="0,0,10,0" Click="NoButton_Click"
                        Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                <Button x:Name="YesButton" Content="Yes (Y)" Width="90" Height="30"
                        Click="YesButton_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
            </StackPanel>

            <!-- Keyboard fallback: Y/N answer the dialog and Escape declines, in case the mouse isn't
                 operational for whatever reason: see Window_PreviewKeyDown in code-behind. -->
            <TextBlock Text="Keyboard: Y = Yes, N = No, Esc = No" Visibility="Collapsed"
                       Foreground="#7A7A82" FontSize="10"
                       HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
