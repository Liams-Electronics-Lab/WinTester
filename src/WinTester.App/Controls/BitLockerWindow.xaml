<Window x:Class="WinTester.App.Controls.BitLockerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BitLocker"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="BitLocker" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

    <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24">
        <StackPanel Width="640">

            <TextBlock Text="BitLocker"
                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="LoadingText"
                       Text="Reading BitLocker status..."
                       Foreground="#7A7A82" FontSize="12" Margin="0,0,0,12" />

            <StackPanel x:Name="ContentPanel" Visibility="Collapsed">

                <!-- Status badge row: image top-left, bold centered ENABLED/DISABLED message to the
                     right; same "badge left, text right" shape as ActivationWindow's genuine/non-genuine
                     row. -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Image x:Name="StatusBadgeImage"
                               Width="110"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <Border Grid.Column="1" Background="#161618" BorderBrush="#3D3D42" BorderThickness="1"
                            CornerRadius="4" Padding="14" MinHeight="110">
                        <TextBlock x:Name="StatusHeadlineText"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <!-- Detail box: drive / volume status / encryption method, same Consolas detail-box
                     styling ActivationWindow's StatusText uses. -->
                <Border Background="#161618" BorderBrush="#3D3D42" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,0,0,14">
                    <TextBlock x:Name="DetailText"
                               FontFamily="Consolas"
                               FontSize="12.5"
                               LineHeight="18"
                               Foreground="#E1E3E8"
                               TextWrapping="Wrap" />
                </Border>

                <!-- TPM row: which TPM specification the machine's chip implements, or that there isn't
                     one. Sits with the BitLocker detail above it because the two are read together — a
                     machine with no usable TPM can still be encrypted, but only with a password/USB key
                     protector rather than the transparent TPM-bound unlock this tool's Enable flow uses. -->
                <Border Background="#161618" BorderBrush="#3D3D42" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TPM"
                                   Foreground="#6B6B72" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Top" Margin="0,3,18,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TpmHeadlineText"
                                       FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="TpmDetailText"
                                       FontFamily="Consolas" FontSize="12"
                                       LineHeight="17" Foreground="#E1E3E8"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Show key row: button + textbox to its right, filled on click. Both this row's
                     button and the Backup Key button below are disabled whenever there's no recovery
                     key to show/back up, or BitLocker isn't enabled. -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ShowKeyButton" Grid.Column="0" Content="Show BitLocker Key"
                            Width="150" Height="30" Margin="0,0,10,0"
                            Click="ShowKeyButton_Click" IsEnabled="False"
                            Background="#2A2A2E" Foreground="White" BorderThickness="0" />

                    <TextBox x:Name="KeyTextBox" Grid.Column="1"
                             Height="30" Padding="8,4"
                             FontFamily="Consolas" FontSize="13"
                             IsReadOnly="True"
                             Background="#161618" Foreground="#E1E3E8"
                             BorderBrush="#3D3D42" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             VerticalScrollBarVisibility="Disabled"
                             Text="" />
                </Grid>
            </StackPanel>

            <TextBlock x:Name="ActionErrorText"
                       Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                       Margin="0,14,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="RefreshButton" Content="Refresh" Width="90" Height="30"
                        Margin="0,0,10,0" Click="RefreshButton_Click"
                        Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                <Button x:Name="BackupKeyButton" Content="Backup BitLocker Key" Width="160" Height="30"
                        Margin="0,0,10,0" Click="BackupKeyButton_Click" IsEnabled="False"
                        Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                <Button x:Name="ToggleProtectionButton" Content="Enable BitLocker" Width="150" Height="30"
                        Margin="0,0,10,0" Click="ToggleProtectionButton_Click" IsEnabled="False"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                <Button x:Name="CloseButton" Content="Close" Width="80" Height="30"
                        Click="CloseButton_Click"
                        Background="#2A2A2E" Foreground="White" BorderThickness="0" />
            </StackPanel>

            <TextBlock Text="Keyboard: Esc = Close" Visibility="Collapsed"
                       Foreground="#7A7A82" FontSize="10"
                       HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
