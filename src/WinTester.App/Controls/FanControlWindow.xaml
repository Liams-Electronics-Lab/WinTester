<Window x:Class="WinTester.App.Controls.FanControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinTester.App.ViewModels"
        xmlns:conv="clr-namespace:WinTester.App.Converters"
        Title="Fans"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="620" Height="580"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate DataType="{x:Type vm:FanRowViewModel}">
            <Border Background="#161618" BorderBrush="#3D3D42" BorderThickness="1" CornerRadius="4"
                    Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E1E3E8" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1" Text="{Binding RpmText}" Foreground="#B7B7BE" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                    <Slider Grid.Column="2" Minimum="0" Maximum="100"
                            Value="{Binding DutyPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsControllable}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsControllable, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Column="2" Text="Not controllable" Foreground="#5E5E66" FontSize="11"
                               FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding IsControllable, Converter={StaticResource InverseBoolToVis}}" />

                    <TextBlock Grid.Column="3" Text="{Binding DutyPercent, StringFormat={}{0:0}%}"
                               Foreground="#B7B7BE" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsControllable, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Vendor tier button. IsActive drives the accent highlight; an implicit tier (one the hardware
             can land in from a slider position but can't be picked directly) is rendered disabled, so it
             can still show as the live state without inviting a click that wouldn't mean anything. -->
        <DataTemplate DataType="{x:Type vm:FanTierViewModel}">
            <Button Content="{Binding Name}"
                    ToolTip="{Binding Description}"
                    IsEnabled="{Binding IsSelectable}"
                    Click="TierButton_Click"
                    MinWidth="82" Height="28" Margin="0,0,6,0"
                    Foreground="White" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2A2A2E" />
                        <Setter Property="BorderBrush" Value="#3D3D42" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E6E76" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Fans" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Fans"
                               Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryText"
                               Text="Reading fans..."
                               Foreground="#7A7A82" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="BackendText"
                               Text="Backend: -"
                               Foreground="#5E5E66" FontSize="11" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Manual speeds are session-only and reset automatically when this window closes."
                               Foreground="#5E5E66" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Vendor tier row. Collapsed entirely unless the active backend implements
                     IFanTierControl and returns at least one tier, so this is invisible on the generic
                     and ASUS-desktop paths rather than showing a row of dead buttons. -->
                <Border x:Name="TierPanel" Grid.Row="1" Visibility="Collapsed"
                        Background="#161618" BorderBrush="#3D3D42" BorderThickness="1" CornerRadius="4"
                        Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TierHeaderText" Text="Hardware modes"
                                   Foreground="#C7C7CC" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="TierHintText"
                                   Text="Sets a fixed fan mode. Overrides sliders until one is moved."
                                   Foreground="#5E5E66" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <ItemsControl x:Name="TierList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="Transparent">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FanList" />
                        </ScrollViewer>

                        <TextBlock x:Name="PlaceholderText"
                                   Text="Reading fans..."
                                   Foreground="#7A7A82" FontSize="13"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ResetAllButton" Content="Reset All to Auto" Width="150" Height="30"
                                Margin="0,0,10,0" Click="ResetAllButton_Click"
                                Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                        <Button x:Name="CloseButton" Content="Close" Width="80" Height="30"
                                Click="CloseButton_Click"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
