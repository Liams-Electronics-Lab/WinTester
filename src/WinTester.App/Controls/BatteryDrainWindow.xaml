<Window x:Class="WinTester.App.Controls.BatteryDrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Drain"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Battery Drain" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

    <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24">
        <StackPanel Width="660">

            <TextBlock Text="Battery Drain" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Logs battery discharge under load."
                       Foreground="#7A7A82" FontSize="12" Margin="0,0,0,16" />

            <!-- ===================== Options panel (pre-run) ===================== -->
            <StackPanel x:Name="OptionsPanel">

                <TextBlock Text="Stop percentage (overrides max length)"
                           Foreground="#B7B7BE" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBox x:Name="StopPercentTextBox" Width="60" Height="28" Text="10"
                             Background="#161618" Foreground="#E1E3E8" BorderBrush="#3D3D42" BorderThickness="1"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                    <TextBlock Text="%" Foreground="#B7B7BE" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="Max test length" Foreground="#B7B7BE" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="LengthInfiniteRadio" Content="Infinite" GroupName="Length" IsChecked="True"
                                 Foreground="#E1E3E8" Margin="0,0,16,0" Checked="LengthPreset_Checked" />
                    <RadioButton x:Name="Length3hRadio" Content="3 hours" GroupName="Length"
                                 Foreground="#E1E3E8" Margin="0,0,16,0" Checked="LengthPreset_Checked" />
                    <RadioButton x:Name="Length2hRadio" Content="2 hours" GroupName="Length"
                                 Foreground="#E1E3E8" Margin="0,0,16,0" Checked="LengthPreset_Checked" />
                    <RadioButton x:Name="Length1hRadio" Content="1 hour" GroupName="Length"
                                 Foreground="#E1E3E8" Margin="0,0,16,0" Checked="LengthPreset_Checked" />
                    <RadioButton x:Name="LengthCustomRadio" Content="Custom" GroupName="Length"
                                 Foreground="#E1E3E8" Checked="LengthPreset_Checked" />
                </StackPanel>
                <StackPanel x:Name="CustomLengthPanel" Orientation="Horizontal" IsEnabled="False" Margin="0,0,0,14">
                    <TextBox x:Name="CustomHoursTextBox" Width="50" Height="28" Text="0"
                             Background="#161618" Foreground="#E1E3E8" BorderBrush="#3D3D42" BorderThickness="1"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <TextBlock Text="hrs" Foreground="#B7B7BE" VerticalAlignment="Center" Margin="6,0,16,0" />
                    <TextBox x:Name="CustomMinutesTextBox" Width="50" Height="28" Text="30"
                             Background="#161618" Foreground="#E1E3E8" BorderBrush="#3D3D42" BorderThickness="1"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <TextBlock Text="min" Foreground="#B7B7BE" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Text="How to drain the battery" Foreground="#B7B7BE" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <CheckBox x:Name="CpuLoadCheckBox" Content="CPU stress" IsChecked="True"
                              Foreground="#E1E3E8" Margin="0,0,20,0" />
                    <CheckBox x:Name="GpuLoadCheckBox" Content="GPU stress (FurMark, off-screen)" IsChecked="False"
                              Foreground="#E1E3E8" />
                </StackPanel>

                <TextBlock x:Name="OptionsErrorText" Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartButton" Content="Start Test" Width="120" Height="30" Margin="0,0,10,0"
                            Click="StartButton_Click" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                    <Button x:Name="CloseOptionsButton" Content="Close" Width="80" Height="30"
                            Click="CloseButton_Click" Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <!-- ===================== Waiting panel (unplug-charger gate) ===================== -->
            <StackPanel x:Name="WaitingPanel" Visibility="Collapsed">
                <TextBlock x:Name="WaitingTitleText" Text="Unplug the charger" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,20,0,10" />
                <TextBlock x:Name="WaitingStatusText" Text="Waiting for the charger to be disconnected."
                           Foreground="#B7B7BE" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelWaitButton" Content="Cancel" Width="100" Height="30"
                            Click="StopButton_Click" Background="#D93B3B" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <!-- ===================== Running panel ===================== -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed">

                <TextBlock x:Name="TimerText" Text="00:00:00:00"
                           FontSize="34" FontWeight="Bold" Foreground="#D93B3B"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />

                <Border Background="#161618" BorderBrush="#3D3D42" BorderThickness="1" CornerRadius="4"
                        Height="220" Margin="0,0,0,14">
                    <Canvas x:Name="GraphCanvas" ClipToBounds="True" SizeChanged="GraphCanvas_SizeChanged" />
                </Border>

                <!-- Row 1 -->
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Start Time" FontSize="10" Foreground="#8A8A93" ToolTip="Time the test began" />
                        <TextBlock x:Name="StartTimeText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Start %" FontSize="10" Foreground="#8A8A93" ToolTip="Battery percent at test start" />
                        <TextBlock x:Name="StartPercentText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Start V" FontSize="10" Foreground="#8A8A93" ToolTip="Battery voltage at test start" />
                        <TextBlock x:Name="StartVoltageText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>

                <!-- Row 2 -->
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Current %" FontSize="10" Foreground="#8A8A93" ToolTip="Live battery percent" />
                        <TextBlock x:Name="CurrentPercentText" Text="--" FontFamily="Consolas" FontSize="14" Foreground="#D93B3B" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Current V" FontSize="10" Foreground="#8A8A93" ToolTip="Live battery voltage" />
                        <TextBlock x:Name="CurrentVoltageText" Text="--" FontFamily="Consolas" FontSize="14" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>

                <!-- Row 3 -->
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Des. Cap (mWh)" FontSize="10" Foreground="#8A8A93" ToolTip="Design Capacity" />
                        <TextBlock x:Name="DesignCapacityText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="FCC @ Start (mWh)" FontSize="10" Foreground="#8A8A93" ToolTip="Full Charge Capacity at test start" />
                        <TextBlock x:Name="FullChargeCapacityText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>

                <!-- Row 4 -->
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Cap. Remaining (mWh)" FontSize="10" Foreground="#8A8A93" ToolTip="Current Capacity Remaining" />
                        <TextBlock x:Name="RemainingCapacityText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Est. Full Cap (mWh)" FontSize="10" Foreground="#8A8A93" ToolTip="Estimated current full-charge capacity" />
                        <TextBlock x:Name="EstFullCapacityText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>

                <!-- Row 5 -->
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Stop Params" FontSize="10" Foreground="#8A8A93" ToolTip="Configured stop percentage / max length" />
                        <TextBlock x:Name="StopParamsText" Text="--" FontFamily="Consolas" FontSize="11" Foreground="#E1E3E8" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Start Batt Health %" FontSize="10" Foreground="#8A8A93" ToolTip="Starting battery health percent (Full Charge / Design)" />
                        <TextBlock x:Name="StartHealthText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>
                <!-- IOCTL-only battery info: shows a greyed N/A placeholder whenever this battery/driver
                     doesn't report a given field. -->
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Cycle Count" FontSize="10" Foreground="#8A8A93" ToolTip="Charge/discharge cycle count, if reported by this battery" />
                        <TextBlock x:Name="CycleCountText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Chemistry" FontSize="10" Foreground="#8A8A93" ToolTip="Battery chemistry, if reported" />
                        <TextBlock x:Name="ChemistryText" Text="--" FontFamily="Consolas" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Serial Number" FontSize="10" Foreground="#8A8A93" ToolTip="Battery serial number, if reported" />
                        <TextBlock x:Name="SerialNumberText" Text="--" FontFamily="Consolas" FontSize="11" Foreground="#E1E3E8" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Manufacturer / Device" FontSize="10" Foreground="#8A8A93" ToolTip="Battery manufacturer and device name, if reported" />
                        <TextBlock x:Name="ManufacturerDeviceText" Text="--" FontFamily="Consolas" FontSize="11" Foreground="#E1E3E8" />
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="CPU Load &amp; Temp" FontSize="10" Foreground="#8A8A93" ToolTip="Live CPU load % and package temp C" />
                        <TextBlock x:Name="CpuLoadTempText" Text="--" FontFamily="Consolas" Foreground="#3ED6FF" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="GPU Load &amp; Temp" FontSize="10" Foreground="#8A8A93" ToolTip="Live GPU load %, core temp C, and hot spot temp C" />
                        <TextBlock x:Name="GpuLoadTempText" Text="--" FontFamily="Consolas" Foreground="#FF4FC3" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock x:Name="RunningErrorText" Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StopButton" Content="Stop Test" Width="110" Height="30" Margin="0,0,10,0"
                            Click="StopButton_Click" Background="#D93B3B" Foreground="White" BorderThickness="0" />
                    <Button x:Name="CloseRunningButton" Content="Close" Width="80" Height="30"
                            Click="CloseButton_Click" IsEnabled="False"
                            Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Keyboard: Esc = Close (disabled while a test is running)" Visibility="Collapsed"
                       Foreground="#7A7A82" FontSize="10" HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
