<Window x:Class="WinTester.App.Controls.DiskInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinTester.App.ViewModels"
        Title="Disk Info"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="940" Height="720"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Drive picker (local: the app has no shared dark ComboBox style) -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#B7B7BE" />
            </Border>
        </ControlTemplate>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D42" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3D3D42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3,24,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboToggle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False" />
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#2A2A2E" BorderBrush="#3D3D42" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The "?" button beside each row name. -->
        <Style x:Key="HelpButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="#B7B7BE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="What does this mean?" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#5E5E66" BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D42" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:DiskInfoRowViewModel}">
            <Border BorderBrush="#2A2A2E" BorderThickness="0,0,0,1" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource HelpButton}"
                            Tag="{Binding}" Click="HelpButton_Click" HorizontalAlignment="Left" />

                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding NameBrush}"
                               FontWeight="{Binding Weight}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                   FontWeight="{Binding Weight}" FontSize="12.5" />
                        <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailForeground}"
                                   FontWeight="{Binding Weight}" FontSize="11" Margin="10,1,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1B1E" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1,1,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Disk Info" Foreground="#B7B7BE" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#B7B7BE" BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="20,14,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Drive selector -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Disk" Foreground="#7A7A82" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="DiskBox" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                              SelectionChanged="DiskBox_SelectionChanged" />
                </Grid>

                <!-- Health box: colour and gradient follow the overall health. -->
                <Border x:Name="HealthBox" Grid.Row="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,10"
                        Background="#3D3D42">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HealthWord" Text="Reading..." Foreground="White"
                                       FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="HealthPercent" Text="" Foreground="#E6FFFFFF" FontSize="14"
                                       Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HealthDisk" Text="" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HealthIdentity" Text="" Foreground="#D9FFFFFF" FontSize="11.5"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HealthReasons" Text="" Foreground="#F2FFFFFF" FontSize="11.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="34" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Data table -->
                <Border Grid.Row="2" Background="#161618" BorderBrush="#3D3D42" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="RowList" Focusable="False" />
                        </ScrollViewer>
                        <TextBlock x:Name="PlaceholderText" Text="Reading disk information..."
                                   Foreground="#7A7A82" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Partition layout, shaped like Disk Management -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#2A2A2E" BorderBrush="#3D3D42" BorderThickness="1"
                            Padding="10,8" Height="96">
                        <StackPanel x:Name="LayoutInfo" VerticalAlignment="Center">
                            <TextBlock x:Name="LayoutName" Text="" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="LayoutType" Text="" Foreground="#B7B7BE" FontSize="11.5" Margin="0,2,0,0" />
                            <TextBlock x:Name="LayoutSize" Text="" Foreground="#B7B7BE" FontSize="11.5" />
                            <TextBlock x:Name="LayoutStatus" Text="" Foreground="#B7B7BE" FontSize="11.5" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#161618" BorderBrush="#3D3D42" BorderThickness="0,1,1,1" Height="96">
                        <Grid x:Name="PartitionStrip" />
                    </Border>
                </Grid>

                <TextBlock x:Name="NotesText" Grid.Row="4" Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="Collapsed" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="RefreshButton" Content="Refresh" Width="90" Height="30"
                            Margin="0,0,10,0" Click="RefreshButton_Click"
                            Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                    <Button x:Name="OpenDiskManagementButton" Content="Open Disk Management"
                            Width="180" Height="30" Margin="0,0,10,0"
                            Click="OpenDiskManagementButton_Click"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                    <Button x:Name="CloseButton" Content="Close" Width="80" Height="30"
                            Click="CloseButton_Click"
                            Background="#2A2A2E" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
