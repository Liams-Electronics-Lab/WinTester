<Application x:Class="WinTester.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                WindowBackgroundBrush / AccentBrush / PrimaryBrush are placeholder defaults so designers
                and any XAML referencing {DynamicResource ...} don't break before App.xaml.cs runs.
                App.xaml.cs.ApplyBrandResources() OVERWRITES these at startup from the loaded brand.json, 
                that is the single source of truth for whitelabel colors, never edit hex values in
                XAML directly.
            -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C1C1F" />
            <SolidColorBrush x:Key="AccentBrush" Color="#426BFF" />
            <SolidColorBrush x:Key="AccentBrushHover" Color="#5C80FF" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#1C1C1F" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
