<Window x:Class="WinTester.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Grid>
            <!-- Real splash.bmp, when present at the app root / next to the exe. -->
            <Image x:Name="SplashImage"
                   Stretch="Uniform"
                   MaxWidth="640"
                   MaxHeight="400"
                   Visibility="Collapsed" />

            <!-- Fallback shown if splash.bmp hasn't been added to the project yet, so the app still
                 runs and the 5-second splash behavior is still visible/testable without the asset. -->
            <StackPanel x:Name="FallbackPanel"
                        Width="480" Height="300"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="AppNameText"
                           Text="WinTester"
                           FontSize="30" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="splash.bmp not found in application root, showing fallback"
                           FontSize="11"
                           Foreground="#8A8A93"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True"
                             Width="220" Height="4"
                             Margin="0,24,0,0"
                             Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>

            <!-- S147: module scan (bottom left) and version (bottom right), small black text over the splash. -->
            <TextBlock x:Name="ScanText"
                       Panel.ZIndex="10"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="8,0,0,6" MaxWidth="440"
                       FontFamily="Arial" FontSize="15"
                       Foreground="Black"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="VersionText"
                       Panel.ZIndex="10"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,8,6"
                       FontFamily="Arial" FontSize="15" FontWeight="Bold"
                       Foreground="Black" />
        </Grid>
    </Border>
</Window>
