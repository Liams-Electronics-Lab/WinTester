<Window x:Class="WinTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinTester.App.Controls"
        xmlns:conv="clr-namespace:WinTester.App.Converters"
        Title="WinTester"
        Icon="app.ico"
        Width="1150" Height="780"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Escape cancels a running suite the same as the on-screen Cancel button, RequestCancelAsync
         (behind CancelCommand) no-ops when IsRunning is false and still raises the Yes/No ConfirmDialog,
         so this is safe to leave bound at all times, running or not. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StringEqualsConverter x:Key="StringEquals" />
        <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVis" />
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis" />
        <conv:PercentToPixelWidthConverter x:Key="PercentToPixelWidth" />
        <conv:PercentToClipRectConverter x:Key="PercentToClipRect" />

        <!-- Flat, dark-themed tab strip. Selected tab gets an accent-colored underline. -->
        <Style x:Key="FlatTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Foreground" Value="#B7B7BE" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0"
                                               ContentSource="Header"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                            <Border x:Name="Underline" Grid.Row="1" Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="{TemplateBinding Background}">
                            <Border DockPanel.Dock="Top" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- =========================== Main content =========================== -->
        <!-- RootContentGrid fills the real window client area at real pixel sizes: the tab strip sits
             against the true top edge and the footer against the true bottom edge at every window size and
             aspect ratio. Scaling is applied per-tab-body instead, by the ScaleToFitHost inside each
             TabItem, so only the tile blocks resize with the window — window chrome (tab headers, footer
             telemetry text) stays at its designed size where it belongs.

             Deliberately excludes RunningOverlay (sibling, below): that layer hosts GpuFrameControl's
             native HwndHost child window during a GPU test, and HwndHost content doesn't reliably follow an
             ancestor RenderTransform/LayoutTransform the way pure-WPF visuals do, so scaling it could
             desync the native window from where WPF thinks it is. RunningOverlay already fills the real
             window edge-to-edge on its own (see its comment block below), so it doesn't need scaling to
             begin with. Window.MinWidth/MinHeight (960x640) is a separate, independent floor on how small
             the window itself can be dragged. -->
        <Grid x:Name="RootContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Style="{StaticResource FlatTabControl}">

                <!-- === Tab 1: Auto Tests === -->
                <TabItem Header="Auto Tests" Style="{StaticResource FlatTabItem}">
                  <!-- Tab1Area is the element the ScaleToFitHost measures against: it's sized by the real
                       window (it's the TabControl's content area), unlike the ScrollViewer's own measure
                       constraint, whose height is infinite. The ScrollViewer only ever shows a bar once the
                       host has hit its MinScale floor and content genuinely can't fit; at any window size
                       with room to spare, the content scales down to fit and no bar appears. -->
                  <Grid x:Name="Tab1Area">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <controls:ScaleToFitHost MeasureSource="{Binding ElementName=Tab1Area}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Control bar: large centered START tile + Select All/Deselect All -->
                        <Grid Grid.Row="0" Margin="0,20,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Run-count controls sit immediately left of Start: set before Start, read
                                 fresh at Start time, disabled mid-run: same posture as Abort on first
                                 failure on the opposite side. -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Number of runs" Foreground="#B7B7BE" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding NumberOfRuns, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsNumberOfRunsEnabled}"
                                             Width="50" Foreground="#E1E3E8" Background="#1C1C1F"
                                             BorderBrush="#3A3A40" Padding="4,2" />
                                </StackPanel>
                                <CheckBox Content="Run infinitely"
                                          IsChecked="{Binding RunInfinitely}"
                                          IsEnabled="{Binding CanStart}"
                                          Foreground="#B7B7BE" FontSize="11"
                                          HorizontalAlignment="Right"
                                          Margin="0,8,0,0" Cursor="Hand" />
                                <CheckBox Content="Disable reports"
                                          IsChecked="{Binding DisableReports}"
                                          IsEnabled="{Binding CanStart}"
                                          Foreground="#B7B7BE" FontSize="11"
                                          HorizontalAlignment="Right"
                                          Margin="0,4,0,0" Cursor="Hand" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding StartCommand}"
                                    Width="220" Height="72"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="20" FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="START" HorizontalAlignment="Center" />
                                    <TextBlock Text="Select at least one test"
                                               FontSize="10" FontWeight="Normal"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding CanStart, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Left" Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Command="{Binding SelectAllToggleCommand}"
                                        Content="{Binding SelectAllButtonLabel}"
                                        Width="140" Height="40"
                                        Background="#2A2A2E" Foreground="White" BorderThickness="0"
                                        Cursor="Hand" />

                                <!-- Set before Start is pressed, applies to that run only; disabled mid-run
                                     since changing it wouldn't affect a queue already in flight. -->
                                <CheckBox Content="Abort on first failure"
                                          IsChecked="{Binding AbortOnFail}"
                                          IsEnabled="{Binding CanStart}"
                                          Foreground="#B7B7BE" FontSize="11"
                                          Margin="4,10,0,0" Cursor="Hand" />
                            </StackPanel>
                        </Grid>

                        <!-- Tile grid: 3 columns, fully data-driven off Tab1Modules. Sized naturally (no
                             scroll container of its own) so the host above it measures the real block
                             height and can scale the whole tab body — control bar and tiles together — as
                             one unit. -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tab1Modules}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TestTileControl />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                      </controls:ScaleToFitHost>
                    </ScrollViewer>
                  </Grid>
                </TabItem>

                <!-- === Tab 2: Tools === -->
                <TabItem Header="Tools" Style="{StaticResource FlatTabItem}">
                  <!-- Same pattern as Tab 1: Tab2Area is the window-sized element the host fits into, and
                       the ScrollViewer only engages once the host bottoms out at MinScale. This tab's three
                       tool groups are the taller of the two bodies, so it's the one most often scaled down
                       rather than up. -->
                  <Grid x:Name="Tab2Area">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <controls:ScaleToFitHost MeasureSource="{Binding ElementName=Tab2Area}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Standalone diagnostic and utility tools."
                                   Foreground="#8A8A93" FontSize="12" Margin="0,0,0,12" />

                        <!-- Standalone tool tiles, grouped by category. Each group is its own header
                             + 3-column UniformGrid ItemsControl, data-driven off its own collection
                             (SystemTools / PowerTools / HidTools) so the groups stay independent of
                             each other and of Tab 1's queue-driven modules. -->
                        <StackPanel Grid.Row="1">

                                <TextBlock Text="System" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#C7C7CC" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SystemTools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:StandaloneToolTileControl />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Power" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#C7C7CC" Margin="0,20,0,8" />
                                <ItemsControl ItemsSource="{Binding PowerTools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:StandaloneToolTileControl />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="HID" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#C7C7CC" Margin="0,20,0,8" />
                                <ItemsControl ItemsSource="{Binding HidTools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:StandaloneToolTileControl />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Deployment" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#C7C7CC" Margin="0,20,0,8" />
                                <ItemsControl ItemsSource="{Binding DeploymentTools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:StandaloneToolTileControl />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                        </StackPanel>
                    </Grid>
                      </controls:ScaleToFitHost>
                    </ScrollViewer>
                  </Grid>
                </TabItem>

            </TabControl>

            <!-- Persistent live-stats + app-version footer. Sits below the shared TabControl (Grid.Row=1)
                 rather than duplicated inside each TabItem's own content Grid; one footer here is visible
                 from both Tab 1 and Tab 2 without repeating markup. Automatically covered by RunningOverlay
                 below (a sibling Grid over this whole Grid) whenever a test is running, same as everything
                 else in RootContentGrid, so it doesn't need its own IsRunning-driven Visibility. Values
                 come from MainViewModel's FooterCpuTemp/FooterGpuCoreTemp/FooterGpuHotspotTemp/
                 FooterRamFreeTotal (refreshed every 2s by the always-on _footerTimer, independent of
                 whether a test is running) and AppVersionDisplay (AppInfo.Version). -->
            <Border Grid.Row="1" Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="0,1,0,0"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Foreground="#6B6B72" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding FooterCpuTemp}" Foreground="#4CD964"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <TextBlock Text="|" Foreground="#3D3D42" FontSize="11"
                                   VerticalAlignment="Center" Margin="14,0" />

                        <TextBlock Text="GPU Core" Foreground="#6B6B72" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding FooterGpuCoreTemp}" Foreground="#FF9F40"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="-" Foreground="#6B6B72" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Text="Hot Spot" Foreground="#6B6B72" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding FooterGpuHotspotTemp}" Foreground="#FF453A"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <TextBlock Text="|" Foreground="#3D3D42" FontSize="11"
                                   VerticalAlignment="Center" Margin="14,0" />

                        <TextBlock Text="RAM Free/Total" Foreground="#6B6B72" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding FooterRamFreeTotal}" Foreground="#AEEBFF"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding AppVersionDisplay}"
                               Foreground="#8A8A93" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- =========================== Running-state overlay: fullscreen test content only ===========================
             This Grid carries only the fullscreen test-content layer. The stats/Cancel/progress-bar UI
             lives in its own separate top-level window, RunOverlayWindow, created/shown by
             MainViewModel.EnterFullscreen right after this window goes fullscreen: GpuFrameControl hosts a
             real Win32 child window (FurmarkEmbedHost) once a test needing it is running, and WPF cannot
             draw its own content on top of a hosted native window from within the same window (the
             "airspace" limitation), so no XAML z-order can layer UI over it here. A distinct top-level
             window sidesteps airspace entirely, since a window higher in the desktop z-order simply covers
             this one's whole client area, HwndHost children included. -->
        <Grid x:Name="RunningOverlay"
              Background="#E6101012"
              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
              IsHitTestVisible="{Binding IsRunning}">

            <!-- LCD test patterns / the reparented FurMark render window fill the ENTIRE running overlay,
                 not a small center cell [this is what "embedded tests fill the screen" means for every
                 current and future test module that routes visual output through TestPatternControl's
                 IsGpuActive/GpuEmbedHost seam, not just the GPU test. No Margin/Grid.Row/Grid.Column] a
                 Grid with no row/column definitions of its own has a single implicit cell that already
                 fills the whole parent, and UserControl's default alignment is Stretch, so this simply
                 covers RunningOverlay edge-to-edge. -->
            <controls:TestPatternControl x:Name="GpuFrameControl"
                                          IsGpuActive="{Binding CurrentTestId, Converter={StaticResource StringEquals}, ConverterParameter=gpu}" />

            <!-- Storage test's running-content visual; a sibling painted after GpuFrameControl above, so
                 it simply covers it (plain WPF z-order, no airspace concern here since neither control
                 hosts a native child window) whenever the storage module is the one running. DataContext
                 is MainViewModel.StorageBenchmarkViewModel, not MainViewModel itself, since
                 StorageBenchmarkControl's bindings (Drives/GridColumns/GridRows, all sourced from that
                 dedicated grid-level view-model) are scoped there, not the whole window's. -->
            <controls:StorageBenchmarkControl DataContext="{Binding StorageBenchmarkViewModel}"
                                               Visibility="{Binding DataContext.CurrentTestId, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVis}, ConverterParameter=storage}" />
        </Grid>
    </Grid>
</Window>
